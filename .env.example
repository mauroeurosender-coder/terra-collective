# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tdwmieejwzysfnpxtvah.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security: keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Allow the admin to run on demo data when Supabase isn't configured (never set in production)
ADMIN_DEMO=1

# Later phases
STRIPE_SECRET_KEY=
RESEND_API_KEY=

# Google Analytics 4 for the Etsy shop (read-only service account, Viewer on the property)
GA4_PROPERTY_ID=
# base64 of the service-account JSON key:  base64 -i key.json | pbcopy
GA4_CREDENTIALS=
